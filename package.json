{
  "name": "fetch-terminal",
  "productName": "Fetch Terminal",
  "version": "1.9.2",
  "description": "A lightweight, open source terminal emulator for Linux desktop, built with Electron. No GTK or Qt dependency, the same UI on every desktop environment.",
  "main": "main.js",
  "license": "GPL-3.0-or-later",
  "private": true,
  "homepage": "https://fetchterminal.org",
  "author": {
    "name": "Fetch Terminal contributors"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gh-lm/fetch.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cx.charlie.fetchterminal",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "productName": "Fetch Terminal",
    "files": [
      "main.js",
      "src/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "artifactName": "Fetch-Terminal-${version}.${ext}",
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "System",
      "executableName": "fetch-terminal",
      "icon": "build/icons",
      "maintainer": "Fetch Terminal contributors"
    },
    "publish": {
      "provider": "github",
      "owner": "gh-lm",
      "repo": "fetch"
    },
    "afterAllArtifactBuild": "scripts/move-to-downloads.js"
  }
}
